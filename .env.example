# ---- runtime
ENV=development                 # production = secure cookies + admin-only API docs
SECRET_KEY=replace-with-a-long-random-string   # signs session tokens; required
ALLOWED_ORIGIN=http://localhost:8000           # the single origin that serves the app (CORS)
# DATABASE_URL=sqlite:////app/backend/data/earnscore.db   # default: backend/data/earnscore.db; Postgres also works
# DATA_DIR=/app/backend/data                   # SQLite file, generated statements, model artifacts
# UPLOAD_DIR=/app/backend/data/uploads         # uploaded statements (outside the web root)
SESSION_HOURS=12
MAX_UPLOAD_MB=10
CONSENT_DEFAULT_DAYS=90
CONSENT_PURGE_DAYS=7            # grace period between consent revocation and data deletion

# ---- language layer (optional; template text is used without a key)
LLM_PROVIDER=gemini             # gemini | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- role accounts created by `make seed` (never hardcoded)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_OFFICER_EMAIL=officer@example.com
SEED_OFFICER_PASSWORD=
SEED_WORKER_EMAIL=worker@example.com
SEED_WORKER_PASSWORD=           # also set as the password of the 24 generated worker accounts
